{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "dongwoobae-portfolio",
  // Account ID는 비밀이 아니다(대시보드 URL에 노출). 여기 두면 CI는
  // CLOUDFLARE_API_TOKEN 하나만 시크릿으로 필요하다.
  "account_id": "1dafd4cb9889ab12c13852360fadf60f",
  // 런타임 타입은 `npm run cf-typegen`이 이 날짜 기준으로 cloudflare-env.d.ts에 생성한다.
  // 날짜를 올릴 때는 cf-typegen을 다시 돌리고 배포 전 preview로 회귀 확인.
  "compatibility_date": "2026-07-02",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // wrangler는 이 필드가 없어도 기본값(전부 off)을 배포마다 보낸다. 대시보드에서 켠
  // 설정이 되돌아가므로 여기 둬야 유지된다. traces는 비용 대비 얻을 게 없어 끈다.
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // next/image 최적화를 Workers에서 처리하려면 필요하다 (케이스 스터디 스크린샷에 사용).
  "images": {
    "binding": "IMAGES",
  },
  // /api/resume-contact 무차별 대입 완화용. namespace_id는 Cloudflare가 발급하는 값이
  // 아니라 계정 안에서 이 네임스페이스를 구분하는 임의의 양의 정수 문자열이다
  // (같은 값을 쓰는 Worker끼리 카운터를 공유한다). simple.period는 10 또는 60만 허용된다.
  // POP 단위 최종 일관성이라 전역 정확도는 보장되지 않는다 — 자동화 속도를 늦추는 용도다.
  "ratelimits": [
    {
      "name": "RESUME_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // custom_domain 라우트는 배포 시 Cloudflare가 해당 zone에 DNS 레코드를 자동 생성한다.
  // 도메인을 옮길 때 손대는 세 곳 중 하나다 (나머지: 새 zone 추가, NEXT_PUBLIC_SITE_URL).
  "routes": [
    { "pattern": "dwoobae.com", "custom_domain": true },
    { "pattern": "www.dwoobae.com", "custom_domain": true },
  ],
}
