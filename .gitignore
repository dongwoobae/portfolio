# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 필요한 키 목록을 문서화하는 파일이라 커밋한다 (값은 들어가지 않는다).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.next-e2e
.open-next
.wrangler
# 로컬 secret 값. 절대 커밋하지 않는다 (운영은 wrangler secret put).
.dev.vars
# wrangler types 생성물(workerd 런타임 타입 14,000줄). 재생성할 때마다 수동 추가분을
# 지우고 prettier도 통과하지 못한다. 코드가 실제로 쓰는 바인딩은 src/cloudflare-env.d.ts에
# 손으로 선언하므로 이 생성물은 커밋하지 않는다.
cloudflare-env.d.ts
test-results
playwright-report
