# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 필요한 키 목록을 문서화하는 파일이라 커밋한다 (값은 들어가지 않는다).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.next-e2e
.open-next
.wrangler
# 로컬 secret 값. 절대 커밋하지 않는다 (운영은 wrangler secret put).
.dev.vars
# cloudflare-env.d.ts는 생성물이지만 커밋한다. CI에 cf-typegen 스텝이 없어서
# 이 파일이 없으면 RESUME_* secret 타입이 사라지고 typecheck가 깨진다.
test-results
playwright-report
