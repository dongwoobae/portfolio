# 절대 URL 생성 기준 (sitemap, OG 이미지, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://dwoobae.com

# Cloudflare Web Analytics 토큰.
# 비워 두는 것이 정상이다 — dwoobae.com은 Cloudflare 대시보드의 "Automatic setup"으로
# 이미 계측 중이고, 프록시가 같은 비콘을 주입한다. 이 값을 채우면 중복 계측된다.
# 사이트가 Cloudflare 프록시를 거치지 않는 환경에서만 채운다.
NEXT_PUBLIC_CF_BEACON_TOKEN=
